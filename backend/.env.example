# Copy to backend/.env for local or Docker use. Keep credentials out of Git.
DATABASE_URL=postgresql://quarry_user:quarry_pass@localhost:5432/quarry_monitoring
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY_FILE=
GEE_PROJECT_ID=
# Optional depth estimates: supply real, co-registered or reprojectable elevation GeoTIFFs.
# Do not point these at Sentinel imagery. Set dates and vertical units explicitly;
# before-date must be on/before the comparison's previous image; after-date must
# fall after that image and on/before the current image. Use a compatible vertical datum.
# Empty values keep depth unavailable.
ELEVATION_BEFORE_RASTER=
ELEVATION_AFTER_RASTER=
ELEVATION_DATA_SOURCE=Configured elevation GeoTIFFs
ELEVATION_VERTICAL_UNITS=
ELEVATION_BEFORE_DATE=
ELEVATION_AFTER_DATE=
DEPTH_MIN_VALID_SAMPLES=3
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_SCHEDULER=true
